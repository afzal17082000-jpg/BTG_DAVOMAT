# ============================================================
# BTG Davomat - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file (contains secrets).
# ============================================================

# --- Telegram Bot ---
# Get this from @BotFather. Keep it secret — NEVER commit the real value to Git.
# Put your real token only in your local .env (gitignored) and in Render's
# Environment tab, never here in .env.example.
BOT_TOKEN=your_bot_token_here

# Public HTTPS URL where index.html (the Mini App) is hosted.
# Telegram requires HTTPS for WebApp buttons (use ngrok/Cloudflare Tunnel in dev).
# In webhook mode (see BOT_MODE below), this is ALSO where Telegram sends bot updates.
WEBAPP_URL=https://your-domain.example.com

# Comma-separated list of Telegram numeric user IDs who are allowed to use
# admin-only bot commands (/export_excel for all staff, /admin_dashboard, /add_employee).
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Bot delivery mode ---
# polling  = bot.js runs as its own always-on process (needs a machine that
#            never sleeps — a VPS, or your own computer during development).
# webhook  = the bot is mounted directly inside server.js; Telegram pushes
#            updates via HTTPS instead of bot.js polling for them. Use this
#            on free-tier hosts (e.g. Render's free web service) that spin
#            down when idle — there's only one process to keep alive, and
#            Telegram's delivery retries wake it back up as needed.
BOT_MODE=polling

# Only used when BOT_MODE=webhook. A random secret string that becomes part
# of the webhook URL path (and is also checked via Telegram's secret-token
# header), so the endpoint can't be guessed or spammed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://btg_user:btg_password@localhost:5432/btg_davomat
PGSSLMODE=disable

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Company Geofence ---
# Target company coordinates (example: Tashkent) and allowed radius in meters.
COMPANY_LAT=41.311081
COMPANY_LNG=69.240562
GEOFENCE_RADIUS_M=100

# Maximum acceptable GPS accuracy (meters) reported by the device.
# Readings less precise than this are rejected to reduce spoofing risk.
MAX_GPS_ACCURACY_M=100

# --- Work Schedule ---
WORK_START=08:30
WORK_END=18:00
DEFAULT_OVERTIME_MULTIPLIER=1.5
# Timezone used for all "business day" calculations (Asia/Tashkent = UTC+5, no DST)
TIMEZONE=Asia/Tashkent
